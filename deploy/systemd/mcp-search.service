[Unit]
Description=MCP Search Server (Tavily)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/cap-shim-mcp
EnvironmentFile=%h/cap-shim-mcp/.env
ExecStart=%h/cap-shim-mcp/.venv/bin/cap-shim serve search --host 0.0.0.0 --port 8081
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
