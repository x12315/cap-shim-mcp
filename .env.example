# MCP Servers — API Keys 模板
# 复制为 .env 并填入真实 key:
#   cp .env.example .env
#   chmod 600 .env
#
# 获取 key:
#   DashScope (视觉): https://dashscope.console.aliyun.com → API-KEY 管理
#   Tavily (搜索):    https://app.tavily.com → API Keys

DASHSCOPE_API_KEY=sk-your-dashscope-key-here
TAVILY_API_KEY=tvly-your-tavily-key-here
